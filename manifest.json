{
  "manifest_version": 3,
  "name": "SoundWave - Tab Volume & Audio Booster",
  "version": "1.0.0",
  "description": "Per-tab volume tuner, 600% booster, bass enhancer, and live visualizer for Chrome tabs.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SoundWave Volume Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
